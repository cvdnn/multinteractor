[Unit]
Description=multinteractor Cloud Hub Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/multinteractor/server
Environment="MI_SERVER_DATA_DIR=/var/lib/multinteractor"
ExecStart=/opt/multinteractor/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
